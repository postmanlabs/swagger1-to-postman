; Install guardrails (SECINV-136)
; Pin exact versions on save so a validated version can't silently float.
save-exact=true

; Release-age gate: block third-party versions younger than ~7 days.
; Honored by npm >= 11 (minimumReleaseAge, minutes). Inert under npm 10 — see
; SCA-FIX-REPORT.md "needs-human": enabling requires an npm 11 / Node bump.
minimumReleaseAge=10080
